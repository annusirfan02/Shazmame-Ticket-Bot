# Freshdesk
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your_freshdesk_api_key

# Target company (Freshdesk "Relationship ID" custom field on the Company)
TARGET_RELATIONSHIP_ID=0-466-515

# Freshdesk company custom field key that stores the Relationship ID
FRESHDESK_RELATIONSHIP_FIELD_KEY=cf_relationship_id

# Tag that triggers the escalation summary/email flow
ESCALATION_TAG=escalate-unresolved

# Number of sentences the sumy LsaSummarizer should extract
SUMMARY_SENTENCE_COUNT=5

# Optional: shared secret to validate incoming Freshdesk webhook requests
# (sent as a query param ?secret=... or header configured in the Freshdesk webhook rule)
WEBHOOK_SECRET=change_me
